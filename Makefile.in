CC=@CC@
CFLAGS=@CFLAGS@
LDFLAGS=@LDFLAGS@
PROJECT_NAME=@PROJECT_NAME@
MAJORVER=@MAJORVER@
MINORVER=@MINORVER@
REVISION=@REVISION@
LIBTOOL=@LIBTOOL@
#LIBS=@LIBS@
LIB=lib@PROJECT_NAME@.@SHARED_LIBRARY_EXTENSION@
SLIB=lib@PROJECT_NAME@.a

PKGCONFIGFILE=@PROJECT_NAME@.pc

MFILES = $(wildcard @PROJECT_NAME@/*.m) $(wildcard @PROJECT_NAME@/*/*.m)
HFILES = version.h $(wildcard @PROJECT_NAME@/*.h) $(wildcard @PROJECT_NAME@/*/*.h)
MOFILES  = $(MFILES:.m=.m.o)
OFILES = $(MOFILES)


INCLUDEDIRS= -I. -I @PROJECT_NAME@ -I/usr/local/include

all:		build/mminfo build/mmdisplay build/mmconvert ${SLIB} build/mmlicense

build/mminfo: mminfo/main.m.o ${SLIB}
	mkdir -p build/
	${CC} ${CFLAGS} -o build/mminfo ${LDFLAGS} mminfo/main.m.o ${SLIB} ${STATIC_LIBS}

build/mmdisplay: mmdisplay/main.m.o ${SLIB}
	mkdir -p build/
	${CC} ${CFLAGS} -o build/mmdisplay ${LDFLAGS} mmdisplay/main.m.o ${SLIB} ${STATIC_LIBS}

build/mmlicense: mmlicense/main.m.o ${SLIB}
	mkdir -p build/
	${CC} ${CFLAGS} -o build/mmlicense ${LDFLAGS} mmlicense/main.m.o ${SLIB} ${STATIC_LIBS}

build/mmconvert: mmconvert/main.m.o ${SLIB}
	mkdir -p build/
	${CC} ${CFLAGS} -o build/mmconvert ${LDFLAGS} mmconvert/main.m.o ${SLIB} ${STATIC_LIBS}


${LIB}: ${OFILES}
	./make_version
	${CC} -shared -o ${LIB} ${LDFLAGS}  ${OFILES} ${LIBS} ${STATIC_LIBS}

${SLIB}:	$(OFILES)
	@LIBTOOL@ ${SLIB}  $(OFILES) 
	@RANLIB@  ${SLIB} 
	
install: ${SLIB} ${LIB} ${PKGCONFIGFILE}
	-rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}.${REVISION}"
	-rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}"
	-rm -f "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}"
	-rm -f "${DESTDIR}/usr/local/lib/${LIB}"
	install -b -g bin -o root -m 644 "${LIB}"  "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}.${REVISION}"
	ln -s "${LIB}.${MAJORVER}.${MINORVER}.${REVISION}" "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}"
	ln -s "${LIB}.${MAJORVER}.${MINORVER}"             "${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}"
	ln -s "${LIB}.${MAJORVER}"                         "${DESTDIR}/usr/local/lib/${LIB}"
	install -b -g bin -o root -m 644 "${SLIB}" "${DESTDIR}/usr/local/lib/${SLIB}"
	-mkdir -p ${DESTDIR}/usr/local/lib/pkgconfig
	-install -b -g bin -o root -m 644 ${PKGCONFIGFILE} ${DESTDIR}/usr/local/lib/pkgconfig/
	-mkdir -p ${DESTDIR}/usr/local/include/@PROJECT_NAME@
	cp $(HFILES) ${DESTDIR}/usr/local/include/@PROJECT_NAME@
	if [ -x /usr/sbin/ldconfig ] ; then ldconfig; fi
	if [ -x /usr/bin/install_name_tool ]; then install_name_tool -id /usr/local/lib/${LIB}.${MAJORVER}.${MINORVER} ${DESTDIR}/usr/local/lib/${LIB}.${MAJORVER}.${MINORVER}.${REVISION}; fi

clean:
	rm -f $(LIB) $(OFILES) ${SLIB}
	rm -rf build/

.SUFFIXES: .m.o .o .m .c

%.m.o:	%.m
	${CC} ${INCLUDEDIRS} -c ${CFLAGS} -x objective-c -fobjc-arc $< -o $@

%.c.o:    %.c
	${CC} ${INCLUDEDIRS} -c ${CFLAGS} -x c -std=c17 $<  -o $@



