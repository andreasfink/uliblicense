# include <sys/time.h> 
#endif 
]]) 

AC_CHECK_HEADERS(sys/types.h,,,
[[#if HAVE_SYS_TYPES_H
# include <sys/types.h>
#endif 
]]) 

AC_CHECK_HEADERS(unistd.h,,,
[[#if HAVE_UNISTD_H
# include <unistd.h> 
#endif 
]]) 

AC_CHECK_HEADERS(sys/poll.h,,,
[[#if HAVE_SYS_POLL_H
# include <sys/poll.h> 
#endif 
]]) 


AC_CHECK_HEADERS(getopt.h,,,
[[#if HAVE_GETOPT_H
# include <getopt.h>
#endif 
]]) 

AC_CHECK_HEADERS(syslog.h,,,
[[#if HAVE_SYSLOG_H
