prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Cflags: -I${includedir} -DHAS_ULIBLICENSE=1
Libs: -L${libdir} -luliblicense

Name: uliblicense
Description: universal license management library
Version: @VERSION@
Requires: ulib  


