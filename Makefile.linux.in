CC=@CC@
CFLAGS=@CFLAGS@
LDFLAGS=@LDFLAGS@

ULIBLICENSE_M   = $(wildcard uliblicense/*.m)
ULIBLICENSE_O	= $(ULIBLICENSE_M:.m=.o)

all:		mminfo mmdisplay

all-full: 	mminfo mmdisplay mmlicense libuliblicense.a


mminfo: mminfo/main.o libuliblicense.a
	${CC} -o mminfo ${LDFLAGS} mminfo/main.m.o uliblicense.a ${LIBS} ${STATIC_LIBS}

mmdisplay: mmdisplay/main.o libuliblicense.a
	${CC} -o mmdisplay ${LDFLAGS} mmdisplay/main.m.o uliblicense.a ${LIBS} ${STATIC_LIBS}

mmlicense: mmlicense/main.o libuliblicense.a
	${CC} -o mmdisplay ${LDFLAGS} mmlicense/main.m.o uliblicense.a ${LIBS} ${STATIC_LIBS}

libuliblicense.a:	$(ULIBLICENSE_M)
	@LIBTOOL@ libuliblicense.a $(ULIBLICENSE_O)
	@RANLIB@  libuliblicense.a
	
clean:
	rm -f mminfo/main.o
	rm -f mmdisplay/main.o
	rm -f mmlicense/main.o
	rm -f uliblicense/*.o 

.SUFFIXES: .o .m .c

%.o:	%.m
	${CC} -c ${CFLAGS} -I uliblicense -x objective-c $<  ${INCLUDEDIRS} -o $@


install: mminfo mmdisplay
	mkdir -p $(DESTDIR)/usr/local/bin/
	install -b -g bin -o root -m 755 mminfo                             $(DESTDIR)/usr/local/bin/mminfo
	install -b -g bin -o root -m 755 mmdisplay                          $(DESTDIR)/usr/local/bin/mmdisplay

install-full:  mminfo mmdisplay uliblicense.a
	mkdir -p $(DESTDIR)/usr/local/bin/
	mkdir -p $(DESTDIR)/usr/local/lib/
	mkdir -p $(DESTDIR)/usr/local/include/
	install -b -g bin -o root -m 755 mminfo                             $(DESTDIR)/usr/local/bin/mminfo
	install -b -g bin -o root -m 755 mmlicense                          $(DESTDIR)/usr/local/bin/mmlicense
	install -b -g bin -o root -m 755 mmdisplay                          $(DESTDIR)/usr/local/bin/mmdisplay
	install -b -g bin -o root -m 644 libuliblicense.a                   $(DESTDIR)/usr/local/lib/libuliblicense.a
	install -b -g bin -o root -m 644 uliblicense.h                      $(DESTDIR)/usr/local/include/uliblicense/uliblicense.h
	install -b -g bin -o root -m 644 UMEncryptedLicense.h               $(DESTDIR)/usr/local/include/uliblicense/UMEncryptedLicense.h   
	install -b -g bin -o root -m 644 UMLegacyLicense.h                  $(DESTDIR)/usr/local/include/uliblicense/UMLegacyLicense.h      
	install -b -g bin -o root -m 644 UMLicense.h                        $(DESTDIR)/usr/local/include/uliblicense/UMLicense.h            
	install -b -g bin -o root -m 644 UMLicenseDirectory.h               $(DESTDIR)/usr/local/include/uliblicense/UMLicenseDirectory.h   
	install -b -g bin -o root -m 644 UMLicenseFile.h                    $(DESTDIR)/usr/local/include/uliblicense/UMLicenseFile.h        
	install -b -g bin -o root -m 644 UMLicenseProduct.h                 $(DESTDIR)/usr/local/include/uliblicense/UMLicenseProduct.h     
	install -b -g bin -o root -m 644 UMLicenseProductFeature.h          $(DESTDIR)/usr/local/include/uliblicense/UMLicenseProductFeature.h  
	install -b -g bin -o root -m 644 UMLicenseProductFeatureList.h      $(DESTDIR)/usr/local/include/uliblicense/UMLicenseProductFeatureList.h
	install -b -g bin -o root -m 644 UMLicenseProductList.h             $(DESTDIR)/usr/local/include/uliblicense/UMLicenseProductList.h
	install -b -g bin -o root -m 644 UMLicenseRefreshDelegateProtocol.h $(DESTDIR)/usr/local/include/uliblicense/UMLicenseRefreshDelegateProtocol.h
	install -b -g bin -o root -m 644 UMLicenseRestriction.h             $(DESTDIR)/usr/local/include/uliblicense/UMLicenseRestriction.h
	install -b -g bin -o root -m 644 UMLicenseRestrictionList.h         $(DESTDIR)/usr/local/include/uliblicense/UMLicenseRestrictionList.h
	install -b -g bin -o root -m 644 UMSignedLicense.h                  $(DESTDIR)/usr/local/include/uliblicense/UMSignedLicense.h
