all:
	-xcodebuild -target mmlic -configuration Release build
	-xcodebuild -target mminfo -configuration Release build
	-xcodebuild -target mmdisp -configuration Release build
	-cp build/Release/mmlic ./mmlic
	-cp build/Release/mminfo ./mminfo
	-cp build/Release/mmdisp ./mmdisp


install:
	mkdir -p $(DESTDIR)/usr/local/bin
	-xcodebuild -target mmlic -configuration Release build
	-xcodebuild -target mminfo -configuration Release build
	-xcodebuild -target mmdisp -configuration Release build
	-cp build/Release/mmlic	$(DESTDIR)/usr/local/bin/mmlic
	-cp build/Release/mminfo $(DESTDIR)/usr/local/bin/mminfo
	-cp build/Release/mmdisp $(DESTDIR)/usr/local/bin/mmdisp

clean:
	-xcodebuild -target mmlic -configuration Release clean
	-xcodebuild -target mminfo -configuration Release clean
	-xcodebuild -target mmdisp -configuration Release clean


install_root_prepare:
	-rm -rf install_root
	./codesign_environment.sh
	mkdir -p install_root/usr/local/bin
	mkdir -p install_scripts/
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mminfo -configuration Release install
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mmdisp -configuration Release install
	pkgbuild --root install_root --install-location /  ${PKG_SIGN}  --version "`cat VERSION`" --identifier "me.fink.mmlic" "mmlic_`cat VERSION`.pkg"
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mmlic -configuration Release install

pkg:	install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`" 

pkg2: install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`" "$(PROJECT_NAME).pkg"
