all:
	-xcodebuild -target uliblicense -configuration Release build
	-xcodebuild -target mminfo      -configuration Release build
	-xcodebuild -target mmdisplay   -configuration Release build
	-xcodebuild -target mmlicense   -configuration Release build
	-xcodebuild -target mmconvert   -configuration Release build

install:
	mkdir -p $(DESTDIR)/usr/local/bin
	-xcodebuild -target uliblicense -configuration Release install
	-xcodebuild -target mminfo      -configuration Release install
	-xcodebuild -target mmdisplay   -configuration Release install
	-xcodebuild -target mmlicense   -configuration Release install
	-xcodebuild -target mmconvert   -configuration Release install

clean:
	-xcodebuild -target uliblicense -configuration Release clean
	-xcodebuild -target mminfo      -configuration Release clean
	-xcodebuild -target mmdisplay   -configuration Release clean
	-xcodebuild -target mmlicense   -configuration Release clean
	-xcodebuild -target mmconvert   -configuration Release clean


install_root_prepare:
	-rm -rf install_root
	./codesign_environment.sh
	mkdir -p install_root/usr/local/bin
	mkdir -p install_scripts/
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target uliblicense  -configuration Release install
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mminfo       -configuration Release install
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mmdisplay    -configuration Release install
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mmlicense    -configuration Release install
	xcodebuild ${XCODESIGN} DSTROOT=install_root -target mmconvert    -configuration Release install

pkg:	install_root_prepare
	pkgbuild --root install_root --install-location /  ${PKG_SIGN}  --version "`cat VERSION`" --identifier "me.fink.mmlic" "mmlic_`cat VERSION`.pkg"

pkg2: install_root_prepare
	pkgbuild --root install_root --install-location /  ${PKG_SIGN}  --version "`cat VERSION`" --identifier "me.fink.mmlic" "mmlic.pkg"
